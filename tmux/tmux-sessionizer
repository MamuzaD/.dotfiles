#!/usr/bin/env bash
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/$(basename "${BASH_SOURCE[0]}")"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux"
CONFIG_FILE="$CONFIG_DIR/tmux-sessionizer.conf"

# config file example
# ------------------------
# # file: ~/.config/tmux-sessionizer/tmux-sessionizer.conf
# # If set this override the default TS_SEARCH_PATHS (~/ ~/personal ~/personal/dev/env/.config)
# TS_SEARCH_PATHS=(~/)
# # If set this add additional search paths to the default TS_SEARCH_PATHS
# # The number prefix is the depth for the Path [OPTIONAL]
# TS_EXTRA_SEARCH_PATHS=(~/ghq:3 ~/Git:3 ~/.config:2)
# # if set this override the TS_MAX_DEPTH (1)
# TS_MAX_DEPTH=2
# # Set to 0 to keep directory choices alphabetically sorted instead of using zoxide frecency
# TS_ZOXIDE_RANKING=1
# # Set to 0 to keep tmux sessions alphabetically sorted instead of ranking them by use
# TS_SESSION_RANKING=1
TS_SEARCH_PATHS=(~/ ~/personal)
TS_EXTRA_SEARCH_PATHS=()
TS_SPECIFIC_PATHS=()
TS_MAX_DEPTH=1
TS_ZOXIDE_RANKING=1
TS_SESSION_RANKING=1
MARGIN=1,1
HEIGHT=100%
# ------------------------

# test if the config file exists
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

sanity_check() {
  if ! command -v tmux &>/dev/null; then
    echo "tmux is not installed. Please install it first."
    exit 1
  fi

  if ! command -v fzf &>/dev/null; then
    echo "fzf is not installed. Please install it first."
    exit 1
  fi
}

switch_to() {
  if [[ -z $TMUX ]]; then
    tmux attach-session -t "$1"
  else
    tmux switch-client -t "$1"
  fi
}

has_session() {
  tmux list-sessions | grep -q "^$1:"
}

hydrate() {
  if [ -f "$2/.tmux-sessionizer" ]; then
    tmux send-keys -t "$1" "source $2/.tmux-sessionizer" c-M
  elif [ -f "$HOME/.tmux-sessionizer" ]; then
    tmux send-keys -t "$1" "source $HOME/.tmux-sessionizer" c-M
  fi
}

# bump the manual use-count ranking for a [TMUX] fzf line by delta (+1/-1)
# no-op for anything that isn't a [TMUX] entry (e.g. [NEW]/[DEL]/directories)
bump_session_use_count() {
  local line="$1" delta="$2"
  [[ "$line" =~ ^\[TMUX\]\ (.*)\ \([0-9]+\)$ ]] || return 0

  local sess="${BASH_REMATCH[1]}"
  tmux has-session -t "$sess" 2>/dev/null || return 0

  local current
  current=$(tmux show-options -t "$sess" -qv "@sessionizer-use-count" 2>/dev/null)
  [[ "$current" =~ ^[0-9]+$ ]] || current=0

  local new_count=$((current + delta))
  ((new_count < 0)) && new_count=0

  tmux set-option -t "$sess" "@sessionizer-use-count" "$new_count"
}

sanity_check

# Add any extra search paths to the TS_SEARCH_PATHS array
# e.g : EXTRA_SEARCH_PATHS=("$HOME/extra1:4" "$HOME/extra2")
# note : Path can be suffixed with :number to limit or extend the depth of the search for the Path

if [[ ${#TS_EXTRA_SEARCH_PATHS[@]} -gt 0 ]]; then
  TS_SEARCH_PATHS+=("${TS_EXTRA_SEARCH_PATHS[@]}")
fi

# vars
tmux_sessions_count=$(tmux list-sessions -F "[TMUX] #{session_name}" 2>/dev/null | wc -l)
if [[ -n "${TMUX}" ]]; then
  current_session=$(tmux display-message -p '#S')
else
  current_session="none"
fi

list_tmux_sessions() {
  if [[ "$TS_SESSION_RANKING" == "0" ]]; then
    if [[ -n "$TMUX" ]]; then
      tmux list-sessions \
        -F '#{session_name}'$'\t''#{?@sessionizer-use-count,#{@sessionizer-use-count},0}' \
        2>/dev/null |
        awk -v current="$current_session" -F '\t' '$1 != current { printf "[TMUX] %s (%s)\n", $1, $2 }' |
        sort
    else
      tmux list-sessions \
        -F '#{session_name}'$'\t''#{?@sessionizer-use-count,#{@sessionizer-use-count},0}' \
        2>/dev/null |
        awk -F '\t' '{ printf "[TMUX] %s (%s)\n", $1, $2 }' |
        sort
    fi
    return
  fi

  local excluded_session=""
  if [[ -n "$TMUX" ]]; then
    excluded_session="$current_session"
  fi

  tmux list-sessions \
    -F '#{@sessionizer-use-count}'$'\t''#{session_last_attached}'$'\t''#{session_name}' \
    2>/dev/null |
    awk -v current="$excluded_session" '
      BEGIN { FS = OFS = "\t" }
      current == "" || $3 != current {
        for (i = 1; i <= 2; i++) {
          if ($i !~ /^[0-9]+$/) {
            $i = 0
          }
        }
        print
      }
    ' |
    sort -t $'\t' -k1,1nr -k2,2nr -k3,3 |
    awk -F '\t' '{ printf "[TMUX] %s (%s)\n", $3, $1 }'
}

# utility function to find directories
find_dirs() {

  # list TMUX sessions
  tmux_sessions_arr=$(list_tmux_sessions)

  if [[ -n "$tmux_sessions_arr" ]]; then
    echo "$tmux_sessions_arr"
  fi

  # new session option
  echo "[NEW]"

  # show delete session option if there is tmux
  if [[ "$tmux_sessions_count" -gt 0 ]]; then
    echo "[DEL]"
  fi

  # note: TS_SEARCH_PATHS is an array of paths to search for directories
  # if the path ends with :number, it will search for directories with a max depth of number ;)
  # if there is no number, it will search for directories with a max depth defined by TS_MAX_DEPTH or 1 if not set
  all_dirs=()

  if [[ ${#TS_SPECIFIC_PATHS[@]} -gt 0 ]]; then
    for specific_path in "${TS_SPECIFIC_PATHS[@]}"; do
      # Expand tilde and check if directory exists
      local full_path
      full_path=$(eval echo "$specific_path") # Expand tilde and shell variables

      if [[ -d "$full_path" ]]; then
        # Add the full path, then format it with tilde for display
        all_dirs+=("$(echo "$full_path" | sed "s|$HOME|~|g")")
      fi
    done
  fi

  for entry in "${TS_SEARCH_PATHS[@]}"; do
    # Check if entry as :number as suffix then adapt the maxdepth parameter
    if [[ "$entry" =~ ^([^:]+):([0-9]+)$ ]]; then
      path="${BASH_REMATCH[1]}"
      depth="${BASH_REMATCH[2]}"
    else
      path="$entry"
    fi

    if [[ -d "$path" ]]; then
      while IFS= read -r dir; do
        dir=$(echo "$dir" | sed "s|$HOME|~|g") # path formatting
        all_dirs+=("$dir")
      done < <(
        find "$path" -mindepth 1 -maxdepth "${depth:-${TS_MAX_DEPTH:-1}}" \
          -path '*/.git' -prune -o -type d \
          -not -path '*/\.*' \
          -print
      )
    fi

    # previous implementation
    #   [[ -d "$path" ]] && find "$path" -mindepth 1 -maxdepth "${depth:-${TS_MAX_DEPTH:-1}}" \
    #     -path '*/.git' -prune -o -type d \
    #     -not -path '*/\.*' \
    #     -print
  done

  if [[ ${#all_dirs[@]} -eq 0 ]]; then
    return
  fi

  if [[ "$TS_ZOXIDE_RANKING" != "0" ]] && command -v zoxide &>/dev/null; then
    # Keep the configured directory scope, but order known directories by the
    # same frecency data that powers `zi`. Unseen directories stay available at
    # the end of the list in alphabetical order.
    awk '
      FILENAME == ARGV[1] {
        if (!candidates[$0]++) {
          fallback[++fallback_count] = $0
        }
        next
      }

      candidates[$0] && !ranked[$0]++ { print }

      END {
        for (i = 1; i <= fallback_count; i++) {
          if (!ranked[fallback[i]]) {
            print fallback[i]
          }
        }
      }
    ' \
      <(printf "%s\n" "${all_dirs[@]}" | sort -u) \
      <(
        zoxide query --list 2>/dev/null | while IFS= read -r dir; do
          if [[ "$dir" == "$HOME" ]]; then
            printf "~\n"
          elif [[ "$dir" == "$HOME/"* ]]; then
            printf "~/%s\n" "${dir#"$HOME/"}"
          else
            printf "%s\n" "$dir"
          fi
        done
      )
  else
    printf "%s\n" "${all_dirs[@]}" | sort -u
  fi
}

# just to simplify preview script
# todo: look into better way for ls/exa
fzf_preview='
  case {} in
    "[NEW]") echo "Create a new session" ;;
    "[DEL]") echo "Delete a session"; tmux list-sessions -F "- #S" ;;
    "[TMUX]"*) tmux list-windows -t "$(echo {} | sed -E "s/^\[TMUX\] (.*) \([0-9]+\)$/\1/")" \
      -F "#I - #W#F | #{pane_current_path}" 2>/dev/null | sed "s|$HOME|~|g" ;;
    "~"*) echo {}; path={}; \
      eval /bin/ls "$path" | /usr/bin/sed "s/^/- /";;
    *) echo "No preview available" ;;
  esac
'

delete_fzf_preview='
  case {} in
    "[ALL]") echo "Delete all sessions except current one" ;;
    *) tmux list-windows -t "$(echo {} | sed "s/^\[TMUX\] //")" \
      -F "#I - #W#F | #{pane_current_path}" 2>/dev/null | sed "s|$HOME|~|g" ;;
  esac
'

# ANSI colors for the fzf list (requires --ansi). fzf strips these escapes
# from the returned selection / {} placeholders, so downstream matching stays
# on clean text.
c_reset=$'\033[0m'
c_tmux=$'\033[38;2;158;206;106m'  # green   -> [TMUX] sessions
c_new=$'\033[38;2;122;162;247m'   # blue    -> [NEW]
c_del=$'\033[38;2;247;118;142m'   # red     -> [DEL] / [ALL]
c_dir=$'\033[38;2;192;202;245m'   # fg      -> directories
c_dim=$'\033[38;2;86;95;137m'     # comment -> use-count suffix

# colorize the main session/dir list; branch (t) on the first match so each
# line gets exactly one rule
colorize_list() {
  sed -E \
    -e "s/^(\[TMUX\]) (.+) (\([0-9]+\))$/${c_tmux}\1${c_reset} \2 ${c_dim}\3${c_reset}/;t" \
    -e "s/^\[NEW\]$/${c_new}[NEW]${c_reset}/;t" \
    -e "s/^\[DEL\]$/${c_del}[DEL]${c_reset}/;t" \
    -e "s/^(.+)$/${c_dir}\1${c_reset}/"
}

# colorize the delete menu: [ALL] red, session names green
colorize_del() {
  sed -E \
    -e "s/^\[ALL\]$/${c_del}[ALL]${c_reset}/;t" \
    -e "s/^(.+)$/${c_tmux}\1${c_reset}/"
}

# just to simplify fzf styling
fzf_default_opts=(
  --ansi
  --bind "j:down,k:up"
  --color "info:#7AA2f7,prompt:#7AA2f7,spinner:#7AA2f7,header:#7AA2f7,pointer:#7AA2f7,preview-bg:#1b2538"
  --border=rounded
  --border-label=tmux-sessionizer
  --border-label-pos=0
  --padding=1
  --reverse
  --no-sort
  --cycle
  --prompt="> "
  --margin="$MARGIN"
  --height "$HEIGHT"
  --header="Current Session: $current_session | Total: $tmux_sessions_count"
)

# internal hooks used by the ctrl-w/ctrl-s fzf key bindings below; not part of
# the public CLI
if [[ "$1" == "--bump" ]]; then
  bump_session_use_count "$2" "$3"
  exit 0
fi

if [[ "$1" == "--list" ]]; then
  find_dirs | colorize_list
  exit 0
fi

if [[ $# -eq 1 ]]; then
  arg="$1"
  # Expand ~ and env vars (for testing path-ness)
  expanded_arg="$(eval echo "$arg")"
  # If arg is absolute, ~-prefixed, or relative and resolves to an existing dir, use it as path.
  if [[ "$expanded_arg" == /* || "$arg" == "~"* || -d "$expanded_arg" ]]; then
    selected="$expanded_arg"
    # Session name from the path
    selected_name="$(basename "$selected" | tr . _)"
  else
    # Not a path: treat as session name, use current directory as the path
    selected_name="$(echo "$arg" | tr . _)"
    selected="$PWD"
  fi
else
  selected=$(
    find_dirs | colorize_list | fzf \
      "${fzf_default_opts[@]}" \
      --header="Current Session: $current_session | Total: $tmux_sessions_count | ctrl-w/ctrl-s: rank up/down" \
      --bind "ctrl-w:execute-silent($SELF --bump {} +1)+reload($SELF --list)" \
      --bind "ctrl-s:execute-silent($SELF --bump {} -1)+reload($SELF --list)" \
      --preview "$fzf_preview"
  )

  selected_name=$(basename "$selected" | tr . _)
fi

if [[ -z $selected ]]; then
  exit 0
fi

if [[ "$selected" == "[NEW]" ]]; then
  # prompt w/o tmux
  if [[ -z $TMUX ]]; then
    read -p "name > " session_name
    tmux new-session -ds "$session_name"
    switch_to "$session_name"
  # run in tmux
  else
    tmux command-prompt -p "name > " "run-shell 'tmux new-session -ds %1 && tmux switch-client -t %1'"
  fi
  exit 0
fi

if [[ "$selected" == "[DEL]" ]]; then
  while true; do
    session_to_del=$(
      (
        echo "[ALL]"
        # list sessions, excluding current so you can't delete it by mistake
        tmux list-sessions -F '#S' | grep -v "^$current_session$"
      ) | colorize_del | fzf \
        "${fzf_default_opts[@]}" \
        --prompt "del > " \
        --preview "$delete_fzf_preview"
    )

    # user pressed ESC / no selection
    if [[ -z "$session_to_del" ]]; then
      break
    fi

    if [[ "$session_to_del" == "[ALL]" ]]; then
      # delete all sessions except current one
      all_sessions=$(tmux list-sessions -F '#S' | grep -v "^$current_session$")
      for s in $all_sessions; do
        tmux kill-session -t "$s"
      done
      break
    else
      # delete chosen session (guaranteed not current due to grep -v above)
      tmux kill-session -t "$session_to_del" 2>/dev/null
    fi
  done

  exit 0
fi

selected_from_tmux=0
if [[ "$selected" =~ ^\[TMUX\]\ (.*)\ \([0-9]+\)$ ]]; then
  selected_from_tmux=1
  selected="${BASH_REMATCH[1]}"
  selected_name="$selected"
fi

tmux_running=$(pgrep tmux)
selected=$(echo "$selected" | sed "s|^~|$HOME|") # expand path back if it has '~'

# Starting a project through the sessionizer should improve its future rank,
# just as changing to it with `zi` would.
if [[ "$TS_ZOXIDE_RANKING" != "0" ]] &&
  [[ "$selected_from_tmux" -eq 0 ]] &&
  [[ -d "$selected" ]] &&
  command -v zoxide &>/dev/null; then
  zoxide add -- "$selected" >/dev/null 2>&1
fi

if [[ "$selected" == "kill" ]]; then
  if [[ -n $tmux_running ]]; then
    tmux kill-server
  fi
  echo "Killed all sessions"
  exit 0
fi

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -ds "$selected_name" -c "$selected"
  hydrate "$selected_name" "$selected"
fi

if ! has_session "$selected_name"; then
  tmux new-session -ds "$selected_name" -c "$selected"
  hydrate "$selected_name" "$selected"
fi

switch_to "$selected_name"
