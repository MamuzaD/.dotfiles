#!/usr/bin/env bash
# rexshuffle: rex port of tmux-window-swapper
# swap or reorder the current tab within the same session

# a block ID works anywhere a session goes
if [[ -z $REX_BLOCK ]]; then
  echo "Must be run inside a rex session."
  exit 1
fi

view=$(rex api call -s "$REX_BLOCK" session.view)
current_window_id=$(jq -r .active_window_id <<< "$view")
total_windows=$(jq '.windows | length' <<< "$view")

if [[ "$total_windows" -le 1 ]]; then
  echo "window-swapper: no other tabs"
  sleep 1
  exit 0
fi

# window_id<TAB>index<TAB>title
windows=$(
  jq -r '.windows | to_entries[] | "\(.value.window_id)\t\(.key + 1)\t\(.value.focused_block_id)"' <<< "$view" |
    while IFS=$'\t' read -r wid idx bid; do
      title=$(rex block call -b "$bid" title 2>/dev/null | jq -r .title)
      printf '%s\t%s\t%s\n' "$wid" "$idx" "${title/#$HOME/\~}"
    done
)

current=$(awk -F '\t' -v w="$current_window_id" '$1 == w' <<< "$windows")
current_window_index=$(cut -f2 <<< "$current")
current_window=$(cut -f3 <<< "$current")

fzf_opts=(
  --bind "ctrl-j:down,ctrl-k:up"
  --color "info:#7AA2f7,prompt:#7AA2f7,spinner:#7AA2f7,header:#7AA2f7,pointer:#7AA2f7,preview-bg:#1b2538"
  --border=rounded
  --border-label=" rexshuffle "
  --border-label-pos=0
  --padding=1
  --reverse
  --cycle
  --prompt="> "
  --margin=1,1
  --height=100%
  --delimiter=$'\t'
  --with-nth='{2}  {3}'
  --nth=1..
  --header="From: [$current_window_index] $current_window | Tabs: $total_windows"
)

selected=$(awk -F '\t' -v w="$current_window_id" '$1 != w' <<< "$windows" | fzf "${fzf_opts[@]}")
[[ -z "$selected" ]] && exit 0

selected_window_id=$(cut -f1 <<< "$selected")
selected_window_index=$(cut -f2 <<< "$selected")
selected_window_name=$(cut -f3 <<< "$selected")

action=$(
  printf '%s\n' \
    $'swap\tSwap the two tabs' \
    $'move\tMove to this position and shift the tabs in between' |
    fzf "${fzf_opts[@]}" \
      --with-nth=2.. \
      --header="[$current_window_index] $current_window → [$selected_window_index] $selected_window_name"
)

# rex window move takes a 1-based --index. moving cur to sel's slot shifts the tabs
# in between, which is "move"; moving sel back to cur's old slot then makes it a swap
move_to() {
  rex window move -s "$REX_BLOCK" "$1" --index "$2" >/dev/null
}

case "${action%%$'\t'*}" in
  swap)
    move_to "$current_window_id" "$selected_window_index"
    move_to "$selected_window_id" "$current_window_index"
    ;;
  move)
    move_to "$current_window_id" "$selected_window_index"
    ;;
esac
