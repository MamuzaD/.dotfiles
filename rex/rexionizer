#!/usr/bin/env bash
# rexionizer: rex port of tmux-sessionizer
# same defaults as tmux-sessionizer, and the same optional ~/.config/tmux/tmux-sessionizer.conf
# lists sessions from this server and every `rex hosts` entry (rex -S <host>);
# rexhosts does the asking
# switching needs Remote Control on (Rex Settings > Rex Server)

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/$(basename "${BASH_SOURCE[0]}")"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux-sessionizer.conf"
# Rex has no per-session options like tmux's @key, so counts live in a side file:
# session_id<TAB>count<TAB>last_switch_epoch (session ids are unique across servers)
COUNTS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/rexionizer/counts"

TS_SEARCH_PATHS=(~/ ~/personal)
TS_EXTRA_SEARCH_PATHS=()
TS_SPECIFIC_PATHS=()
TS_MAX_DEPTH=1
TS_ZOXIDE_RANKING=1
TS_SESSION_RANKING=1

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

for cmd in rex fzf jq rexhosts; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "$cmd is not installed. Please install it first."
    read -rn1
    exit 1
  fi
done

mkdir -p "$(dirname "$COUNTS_FILE")"
touch "$COUNTS_FILE"

# one view of our session: its id (skipped in listings) and this pane's owner,
# the client you're typing on
view=$(rex api call -s "$REX_BLOCK" session.view 2>/dev/null)
current_session=$(jq -r '.session_id // empty' <<<"$view" 2>/dev/null)
current_session="${current_session:-none}"

# servers
# ------------------------
# fzf opens on this machine's sessions at once; `rexhosts prefetch` asks the
# other hosts in the background into REXIONIZER_TMP (its files are listed in
# rexhosts), and fzf reloads when they answer. The fzf hooks (--list, --bump,
# ...) read the same dir.
LOCAL_SERVER=$(rexhosts server)
export LOCAL_SERVER
HOSTS=() # other hosts' labels

# rex against SERVER
rex_on() {
  local server=$1
  shift
  if [[ "$server" == "$LOCAL_SERVER" ]]; then
    rex "$@"
  else
    rex --timeout 3s -S "$server" "$@"
  fi
}
export -f rex_on

# wait up to SECS for FILE to appear
wait_for() {
  local n=$((${2:-5} * 20))
  while [[ ! -e "$1" ]] && ((n-- > 0)); do sleep 0.05; done
  [[ -e "$1" ]]
}

# SESSIONS, LOCAL_SERVER, HOSTS and REX_CLIENT from the run's listing, else this
# machine's sessions only
load_shared() {
  local T=$REXIONIZER_TMP n h
  if [[ -e "$T/sessions" ]]; then
    SESSIONS=$(cat "$T/sessions")
    LOCAL_SERVER=$(cat "$T/server")
    HOSTS=()
    while IFS=$'\t' read -r n h; do HOSTS+=("$h"); done <"$T/hosts"
  else
    SESSIONS=$(rexhosts local)
  fi
  [[ -s "$T/client" ]] && REX_CLIENT=$(cat "$T/client")
  export LOCAL_SERVER REX_CLIENT
}

if [[ -n "${REXIONIZER_TMP:-}" ]]; then # an fzf hook: reuse this run's listing
  load_shared
else
  REXIONIZER_TMP=$(mktemp -d)
  export REXIONIZER_TMP
  # whichever of us and rexhosts prefetch finishes last removes the dir
  trap 'touch "$REXIONIZER_TMP/main.done"; [[ -e "$REXIONIZER_TMP/prefetch.done" ]] && rm -rf "$REXIONIZER_TMP"' EXIT
  SESSIONS=$(rexhosts local)
fi

# "server: label" for every session except the one we're in
rex_sessions() {
  awk -F'\t' -v cur="$current_session" '$3 != cur { print $1 ": " $2 }' <<<"$SESSIONS"
}

# "server: label" -> server<TAB>session_id
session_for() {
  awk -F'\t' -v e="$1" '$1 ": " $2 == e { print $1 "\t" $3; exit }' <<<"$SESSIONS"
}

# session id for a label on a server (this one by default)
session_id_for() {
  awk -F'\t' -v s="${2:-$LOCAL_SERVER}" -v l="$1" '$1 == s && $2 == l { print $3; exit }' <<<"$SESSIONS"
}

# ranking
# ------------------------
# add delta to a session's count, floored at 0, and drop entries for sessions that
# are gone and unused for 30 days (an offline host's sessions are missing from the
# listing, so dropping on that alone would wipe their counts).
# stamp, when given, records the switch time used to break ties.
update_count() {
  local sid="$1" delta="$2" stamp="${3:-}" tmp
  [[ -n "$sid" ]] || return 0
  [[ -n "$SESSIONS" ]] || return 0 # a failed listing must not wipe the counts

  tmp=$(mktemp "$COUNTS_FILE.XXXXXX") || return 0
  awk -F '\t' -v OFS='\t' -v sid="$sid" -v delta="$delta" -v stamp="$stamp" -v cutoff="$(($(date +%s) - 30 * 86400))" '
    FILENAME == ARGV[1] { live[$3] = 1; next }
    $1 == sid {
      seen = 1
      n = $2 + delta
      print sid, (n < 0 ? 0 : n), (stamp != "" ? stamp : $3)
      next
    }
    live[$1] || $3 > cutoff { print }
    END { if (!seen) print sid, (delta < 0 ? 0 : delta + 0), stamp + 0 }
  ' <(printf "%s\n" "$SESSIONS") "$COUNTS_FILE" >"$tmp" && mv "$tmp" "$COUNTS_FILE" || rm -f "$tmp"
}

# "[REX] server: label (count)" lines, most used first, then most recently switched to
list_rex_sessions() {
  local lines
  lines=$(
    awk -F '\t' -v OFS='\t' -v cur="$current_session" '
      FILENAME == ARGV[1] { count[$1] = $2; last[$1] = $3; next }
      $3 != cur { print count[$3] + 0, last[$3] + 0, $1 ": " $2 }
    ' "$COUNTS_FILE" <(printf "%s\n" "$SESSIONS")
  )
  [[ -n "$lines" ]] || return 0
  if [[ "$TS_SESSION_RANKING" == "0" ]]; then
    printf "%s\n" "$lines" | sort -t $'\t' -k3,3
  else
    printf "%s\n" "$lines" | sort -t $'\t' -k1,1nr -k2,2nr -k3,3
  fi | awk -F '\t' '{ printf "[REX] %s (%s)\n", $3, $1 }'
}

# list
# ------------------------
hydrate() {
  if [ -f "$2/.tmux-sessionizer" ]; then
    rex send -s "$1" "source $2/.tmux-sessionizer"$'\n'
  elif [ -f "$HOME/.tmux-sessionizer" ]; then
    rex send -s "$1" "source $HOME/.tmux-sessionizer"$'\n'
  fi
}

find_dirs() {
  list_rex_sessions
  echo "[NEW]"
  [[ -n "$(rex_sessions)" ]] && echo "[DEL]"

  all_dirs=()
  for specific_path in "${TS_SPECIFIC_PATHS[@]}"; do
    full_path=$(eval echo "$specific_path")
    [[ -d "$full_path" ]] && all_dirs+=("${full_path/#"$HOME"/\~}")
  done

  for entry in "${TS_SEARCH_PATHS[@]}"; do
    depth=""
    if [[ "$entry" =~ ^([^:]+):([0-9]+)$ ]]; then
      path="${BASH_REMATCH[1]}"
      depth="${BASH_REMATCH[2]}"
    else
      path="$entry"
    fi
    if [[ -d "$path" ]]; then
      while IFS= read -r dir; do
        all_dirs+=("${dir/#"$HOME"/\~}")
      done < <(
        find "$path" -mindepth 1 -maxdepth "${depth:-${TS_MAX_DEPTH:-1}}" \
          -path '*/.git' -prune -o -type d -not -path '*/\.*' -print
      )
    fi
  done

  [[ ${#all_dirs[@]} -eq 0 ]] && return

  if [[ "$TS_ZOXIDE_RANKING" != "0" ]] && command -v zoxide &>/dev/null; then
    # zoxide frecency first, unseen dirs after in alphabetical order
    awk '
      FILENAME == ARGV[1] { if (!candidates[$0]++) fallback[++n] = $0; next }
      candidates[$0] && !ranked[$0]++ { print }
      END { for (i = 1; i <= n; i++) if (!ranked[fallback[i]]) print fallback[i] }
    ' \
      <(printf "%s\n" "${all_dirs[@]}" | sort -u) \
      <(zoxide query --list 2>/dev/null | sed "s|^$HOME\$|~|; s|^$HOME/|~/|")
  else
    printf "%s\n" "${all_dirs[@]}" | sort -u
  fi
}

fzf_preview='
  case {} in
    "[NEW]") echo "Create a new session" ;;
    "[DEL]") echo "Delete a session" ;;
    "[REX]"*) e=$(echo {} | sed -E "s/^\[REX\] (.*) \([0-9]+\)$/\1/"); rex_on "${e%%: *}" capture -s "${e#*: }" --format vt --trim 2>/dev/null | tr -d "\r" | tail -n "$FZF_PREVIEW_LINES" ;;
    "~"*) eza -1a --icons --git --group-directories-first --color=always "$(echo {} | sed "s|^~|$HOME|")" ;;
    *) echo "No preview available" ;;
  esac
'

c_reset=$'\033[0m'
c_rex=$'\033[38;2;158;206;106m' # green -> [REX] sessions
c_new=$'\033[38;2;122;162;247m' # blue  -> [NEW]
c_del=$'\033[38;2;247;118;142m' # red   -> [DEL] / [ALL]
c_dir=$'\033[38;2;192;202;245m' # fg    -> directories
c_dim=$'\033[38;2;86;95;137m'   # comment -> server name, use-count suffix

colorize_list() {
  sed -E \
    -e "s/^(\[REX\]) ([^:]+): (.+) (\([0-9]+\))$/${c_rex}\1${c_reset} ${c_dim}\2:${c_reset} \3 ${c_dim}\4${c_reset}/;t" \
    -e "s/^\[NEW\]$/${c_new}[NEW]${c_reset}/;t" \
    -e "s/^\[DEL\]$/${c_del}[DEL]${c_reset}/;t" \
    -e "s/^(.+)$/${c_dir}\1${c_reset}/"
}

# internal hooks for the ctrl-w/ctrl-s fzf bindings below
if [[ "$1" == "--bump" ]]; then
  if [[ "$2" =~ ^\[REX\]\ (.*)\ \([0-9]+\)$ ]]; then
    IFS=$'\t' read -r _ sid <<<"$(session_for "${BASH_REMATCH[1]}")"
    update_count "$sid" "$3"
  fi
  exit 0
fi

# REXIONIZER_TMP/full marks that fzf has (or will never get) every host's list
if [[ "$1" == "--list" ]]; then
  [[ -e "$REXIONIZER_TMP/sessions" ]] && touch "$REXIONIZER_TMP/full"
  find_dirs | colorize_list
  exit 0
fi

# fzf's load hook: refresh the header, and while the list fzf holds is this
# machine's only (the first load, or a ctrl-w/ctrl-s that cancelled the full
# reload), reload with every host's
if [[ "$1" == "--on-load" ]]; then
  [[ -e "$REXIONIZER_TMP/full" ]] || printf 'reload-sync(%s --list-full)+' "$SELF"
  printf 'change-header:%s' "$("$SELF" --header)" # the : form takes the rest, ) and all
  exit 0
fi

# the full listing, once every host has answered (on timeout, this machine's,
# and stop trying)
if [[ "$1" == "--list-full" ]]; then
  wait_for "$REXIONIZER_TMP/sessions" 8 && load_shared
  touch "$REXIONIZER_TMP/full"
  find_dirs | colorize_list
  exit 0
fi

if [[ "$1" == "--header" ]]; then
  printf 'Session: %s | Client: %s\nTotal: %s | ctrl-w/ctrl-s: rank up/down' \
    "$(awk -F'\t' -v cur="$current_session" '$3 == cur { print $2; exit }' <<<"$SESSIONS")" \
    "${REX_CLIENT:-?}" "$(grep -c . <<<"$SESSIONS")"
  exit 0
fi

# clients
# ------------------------
# The device to switch, as a client *label*: the same app is a different client
# (ID) on every server, but -C takes a label anywhere. REX_CLIENT comes from the
# init.lua popup; else this pane's owner; else the only connected app.
app_clients() {
  rex client ls --json | jq -c '[.clients[] | select(.info.kind == "app" and .connection_state == "connected")]'
}

resolve_client() {
  local id label
  # an ID only means something on the server that issued it: swap it for its
  # label here if this server issued it, else rexhosts prefetch does
  if [[ "$REX_CLIENT" == client:* ]]; then
    label=$(rex client inspect "$REX_CLIENT" --json 2>/dev/null | jq -r '.client.info.label // empty')
    [[ -n "$label" ]] && export REX_CLIENT=$label
  fi
  [[ -n "$REX_CLIENT" ]] && return
  id=$(jq -r --arg b "$REX_BLOCK" 'first(.. | objects | select(.block_id == $b and (.owner // "") != "") | .owner) // empty' <<<"$view" 2>/dev/null)
  [[ -z "$id" ]] && id=$(app_clients | jq -r 'if length == 1 then .[0].client_id else empty end')
  [[ -n "$id" ]] && export REX_CLIENT=$(rex client inspect "$id" --json | jq -r '.client.info.label // .client.client_id')
}

# ambiguous: let the user choose which device to switch
pick_client() {
  [[ -n "$REX_CLIENT" ]] && return
  local pick
  pick=$(app_clients | jq -r '.[] | "\(.info.label // .client_id)\t\(.info.platform)"' |
    fzf "${fzf_default_opts[@]}" --prompt "client > " --delimiter '\t' --no-preview)
  [[ -n "$pick" ]] && export REX_CLIENT="${pick%%$'\t'*}"
}

resolve_client

# remote dirs
# ------------------------
# sets server/path to where DIR's session should start. If other hosts have the
# same path under their home, asks which to use.
pick_server() {
  local dir=$1 choices pick
  server=$LOCAL_SERVER path=$dir
  [[ ${#HOSTS[@]} -eq 0 ]] && return 0
  choices=$(rexhosts where "$dir" "$REXIONIZER_TMP")
  [[ -z "$choices" ]] && return 0
  pick=$(printf '%s\t%s\n%s\n' "$LOCAL_SERVER" "$dir" "$choices" |
    awk -F'\t' -v OFS='\t' '{ d = $2; sub("^/(Users|home)/[^/]+", "~", d); print $1, $2, $1 ": " d }' |
    fzf "${fzf_default_opts[@]}" --prompt "start on > " --delimiter '\t' --with-nth 3 --no-preview) || return 1
  [[ -n "$pick" ]] || return 1
  IFS=$'\t' read -r server path _ <<<"$pick"
}

# actions
# ------------------------
switch_to() {
  local server=$1 sid=$2
  # another server's client ID: wait for rexhosts prefetch's label
  [[ "$REX_CLIENT" == client:* ]] && wait_for "$REXIONIZER_TMP/client" 4 && load_shared
  pick_client
  [[ -z "$REX_CLIENT" ]] && {
    echo "No client chosen; not switching."
    read -rn1
    return 1
  }
  if rex_on "$server" -C "$REX_CLIENT" do session.select session_id="$sid"; then
    [[ "$sid" != "$current_session" ]] && update_count "$sid" 1 "$(date +%s)"
  else
    echo "Couldn't switch $REX_CLIENT on $server. Is it connected there with Remote Control on?"
    read -rn1
  fi
}

current_label=$(awk -F'\t' -v cur="$current_session" '$3 == cur { print $2; exit }' <<<"$SESSIONS")
total=$(grep -c . <<<"$SESSIONS")

fzf_default_opts=(
  --ansi
  --bind "j:down,k:up"
  --color "info:#7AA2f7,prompt:#7AA2f7,spinner:#7AA2f7,header:#7AA2f7,pointer:#7AA2f7,preview-bg:#1b2538"
  --border=rounded
  --border-label=rexionizer
  --border-label-pos=0
  --padding=1
  --reverse
  --no-sort
  --cycle
  --with-shell "bash -c" # previews call the exported rex_on
  --prompt="> "
  --header="Session: ${current_label:-none} | Client: ${REX_CLIENT:-?} | Total: $total"
)

rexhosts prefetch "$REXIONIZER_TMP" </dev/null &>/dev/null &

if [[ $# -eq 1 ]]; then
  selected="$(eval echo "$1")"
else
  # opens on this machine's sessions; the first load swaps in every host's
  selected=$(
    find_dirs | colorize_list | fzf "${fzf_default_opts[@]}" \
      --header="$("$SELF" --header)" \
      --bind "load:transform($SELF --on-load)" \
      --bind "ctrl-w:execute-silent($SELF --bump {} +1)+reload($SELF --list)" \
      --bind "ctrl-s:execute-silent($SELF --bump {} -1)+reload($SELF --list)" \
      --preview "$fzf_preview" --preview-window='right,60%'
  )
fi

if [[ -z $selected ]]; then
  exit 0
fi

wait_for "$REXIONIZER_TMP/sessions" 8
load_shared
# pickers after this one (start on, del, client) show the full listing's header
for i in "${!fzf_default_opts[@]}"; do
  [[ "${fzf_default_opts[i]}" == --header=* ]] &&
    fzf_default_opts[i]="--header=Session: ${current_label:-none} | Client: ${REX_CLIENT:-?} | Total: $(grep -c . <<<"$SESSIONS")"
done

if [[ "$selected" == "[NEW]" ]]; then
  read -rp "name > " session_name
  if [[ -n "$session_name" ]]; then
    sid=$(rex new "$session_name" --json | jq -r .session_id)
    sleep 0.3 # give the app a moment to see the new session before switching
    switch_to "$LOCAL_SERVER" "$sid"
  fi
  exit 0
fi

if [[ "$selected" == "[DEL]" ]]; then
  while true; do
    rexhosts list "$REXIONIZER_TMP"
    load_shared
    [[ -z "$(rex_sessions)" ]] && break
    to_del=$(
      (
        echo "[ALL]"
        rex_sessions
      ) |
        sed -E -e "s/^\[ALL\]$/${c_del}[ALL]${c_reset}/;t" -e "s/^([^:]+): (.+)$/${c_dim}\1:${c_reset} ${c_rex}\2${c_reset}/" |
        fzf "${fzf_default_opts[@]}" --prompt "del > " \
          --preview 'case {} in "[ALL]") echo "Kill every listed session, on every server" ;; *) e={}; rex_on "${e%%: *}" capture -s "${e#*: }" --format vt --trim 2>/dev/null | tr -d "\r" | tail -n "$FZF_PREVIEW_LINES" ;; esac'
    )
    [[ -z "$to_del" ]] && break
    if [[ "$to_del" == "[ALL]" ]]; then
      while IFS= read -r e; do
        IFS=$'\t' read -r server sid <<<"$(session_for "$e")"
        rex_on "$server" kill "$sid" &>/dev/null
      done < <(rex_sessions)
      break
    fi
    IFS=$'\t' read -r server sid <<<"$(session_for "$to_del")"
    rex_on "$server" kill "$sid" &>/dev/null
  done
  exit 0
fi

if [[ "$selected" =~ ^\[REX\]\ (.*)\ \([0-9]+\)$ ]]; then
  IFS=$'\t' read -r server sid <<<"$(session_for "${BASH_REMATCH[1]}")"
  switch_to "$server" "$sid"
  exit 0
fi

selected="${selected/#\~/$HOME}"
selected_name=$(basename "$selected" | tr . _)

if [[ "$TS_ZOXIDE_RANKING" != "0" ]] && [[ -d "$selected" ]] && command -v zoxide &>/dev/null; then
  zoxide add -- "$selected" &>/dev/null
fi

pick_server "$selected" || exit 0

if [[ "$server" == "$LOCAL_SERVER" ]]; then
  sid=$(session_id_for "$selected_name")
  if [[ -z "$sid" ]]; then
    sid=$(rex new "$selected_name" --cwd "$selected" --json | jq -r .session_id)
    sleep 0.3 # give the app a moment to see the new session before switching
    hydrate "$sid" "$selected"
  fi
else
  sid=$(session_id_for "$selected_name" "$server")
  if [[ -z "$sid" ]]; then
    sid=$(rex_on "$server" new "$selected_name" --cwd "$path" --json | jq -r .session_id)
    sleep 0.3
  fi
fi

switch_to "$server" "$sid"
